generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  DOCTOR
  PATIENT
}

enum ConsentType {
  HISTORY_COLLECTION
  DOCUMENT_PROCESSING
  DATA_SHARING
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

enum IntakeMode {
  GENERAL
  AYUSH
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum InterviewStage {
  CHIEF_COMPLAINT
  HPI
  PAST_MEDICAL_HISTORY
  SURGICAL_HISTORY
  MEDICATIONS
  ALLERGIES
  FAMILY_HISTORY
  PERSONAL_HISTORY
  REVIEW_OF_SYSTEMS
  DOCUMENT_UPLOAD
  SUMMARY_GENERATION
  COMPLETED
}

enum AlertSeverity {
  HIGH
  CRITICAL
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  DONE
  FAILED
}

enum SummaryStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
}

enum SummarySectionType {
  CHIEF_COMPLAINT
  HPI
  PAST_MEDICAL_HISTORY
  PAST_SURGICAL_HISTORY
  MEDICATIONS
  ALLERGIES
  FAMILY_HISTORY
  PERSONAL_HISTORY
  REVIEW_OF_SYSTEMS
}

enum QueuePriority {
  NORMAL
  URGENT
  CRITICAL
}

enum QueueStatus {
  PENDING
  DIAGNOSED
}

enum TimelineSource {
  INTERVIEW
  DOCUMENT
  SUMMARY
}

enum MedicalHistoryCategory {
  CONDITION
  SURGERY
  MEDICATION
  ALLERGY
  FAMILY
  PERSONAL
  OTHER
}

enum VerificationChannel {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  PATIENT_REGISTRATION
  PATIENT_CHECK_IN
  STAFF_REGISTRATION
  DOCTOR_REGISTRATION
}

model User {
  id                 Int                     @id @default(autoincrement())
  name               String
  email              String                  @unique
  role               UserRole
  hashedPassword     String
  department         String?
  gender             String?
  DOB                DateTime?
  licenceNumber      String?                 @unique
  phoneNumber        String
  hospitalPosting    String?
  governmentId       String?                 @unique
  doctorCode         String?                 @unique
  staffCode          String?                 @unique
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  registeredPatients Patient[]               @relation("PatientRegisteredBy")
  assignedPatients   Patient[]               @relation("PatientAssignedDoctor")
  consentsRecorded   Consent[]               @relation("ConsentRecordedBy")
  historiesRecorded  MedicalHistory[]        @relation("MedicalHistoryRecordedBy")
  interviewsCreated  Interview[]             @relation("InterviewCreatedBy")
  documentsUploaded  MedicalDocument[]       @relation("DocumentUploadedBy")
  summariesApproved  ClinicalSummary[]       @relation("SummaryApprovedBy")
  doctorQueue        DoctorQueueItem[]       @relation("QueueDoctor")
  queueAssignments   DoctorQueueItem[]       @relation("QueueAssignedBy")
  alertsAcknowledged TriageAlert[]           @relation("AlertAcknowledgedBy")
  doctorFavorites    StaffDoctorFavorite[]   @relation("FavoriteStaff")
  favoritedByStaff   StaffDoctorFavorite[]   @relation("FavoriteDoctor")
  verifications      VerificationChallenge[]
  auditEvents        AuditEvent[]
}

model Patient {
  id                  Int                     @id @default(autoincrement())
  medikioskId         String?                 @unique
  email               String                  @unique
  name                String
  DOB                 DateTime
  adhaarNumber        String                  @unique
  abhaId              String?                 @unique
  phoneNumber         String
  gender              String
  preferredLanguage   String
  otpVerified         Boolean                 @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  user                User?                   @relation("PatientAssignedDoctor", fields: [userId], references: [id])
  userId              Int?
  registeredByStaff   User?                   @relation("PatientRegisteredBy", fields: [registeredByStaffId], references: [id])
  registeredByStaffId Int?
  consents            Consent[]
  medicalHistories    MedicalHistory[]
  interviews          Interview[]
  alerts              TriageAlert[]
  documents           MedicalDocument[]
  summaries           ClinicalSummary[]
  timeline            TimelineEntry[]
  queueItems          DoctorQueueItem[]
  verifications       VerificationChallenge[]
  auditEvents         AuditEvent[]

  @@index([userId])
  @@index([registeredByStaffId])
}

model Consent {
  id         Int           @id @default(autoincrement())
  patientId  Int
  userId     Int?
  type       ConsentType
  status     ConsentStatus @default(GRANTED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  patient    Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy User?         @relation("ConsentRecordedBy", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([patientId, type])
  @@index([userId])
}

model MedicalHistory {
  id          Int                    @id @default(autoincrement())
  patientId   Int
  userId      Int?
  category    MedicalHistoryCategory @default(OTHER)
  description String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  patient     Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy  User?                  @relation("MedicalHistoryRecordedBy", fields: [userId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([userId])
}

model Interview {
  id                  String            @id @default(cuid())
  patientId           Int
  createdByStaffId    Int?
  mode                IntakeMode
  language            String
  status              InterviewStatus   @default(IN_PROGRESS)
  currentStage        InterviewStage    @default(CHIEF_COMPLAINT)
  questionIndex       Int               @default(0)
  pendingQuestionId   String            @default("chief_complaint")
  pendingQuestionText String            @default("What brings you in today?")
  startedAt           DateTime          @default(now())
  completedAt         DateTime?
  patient             Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdByStaff      User?             @relation("InterviewCreatedBy", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  answers             InterviewAnswer[]
  alerts              TriageAlert[]
  documents           MedicalDocument[]
  summary             ClinicalSummary?
  timeline            TimelineEntry[]
  auditEvents         AuditEvent[]

  @@index([patientId, status])
  @@index([createdByStaffId])
}

model InterviewAnswer {
  id               String         @id @default(cuid())
  interviewId      String
  stage            InterviewStage
  questionId       String
  questionText     String
  answer           String
  spokenTranscript String?
  translatedAnswer String?
  language         String
  createdAt        DateTime       @default(now())
  interview        Interview      @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, questionId])
}

model TriageAlert {
  id               String        @id @default(cuid())
  interviewId      String
  patientId        Int
  severity         AlertSeverity
  message          String
  acknowledged     Boolean       @default(false)
  acknowledgedById Int?
  acknowledgedAt   DateTime?
  createdAt        DateTime      @default(now())
  interview        Interview     @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  patient          Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  acknowledgedBy   User?         @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([patientId, acknowledged])
  @@index([interviewId])
  @@index([acknowledgedById])
}

model MedicalDocument {
  id               String          @id @default(cuid())
  patientId        Int
  interviewId      String?
  uploadedById     Int?
  originalFileName String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  status           DocumentStatus  @default(UPLOADED)
  extractedData    Json?
  failureReason    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  patient          Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  interview        Interview?      @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  uploadedBy       User?           @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  timeline         TimelineEntry[]

  @@index([patientId, status])
  @@index([interviewId])
  @@index([uploadedById])
}

model ClinicalSummary {
  id           String           @id @default(cuid())
  patientId    Int
  interviewId  String?          @unique
  mode         IntakeMode
  status       SummaryStatus    @default(DRAFT)
  approvedById Int?
  approvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  interview    Interview?       @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  approvedBy   User?            @relation("SummaryApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  sections     SummarySection[]
  ayushData    AyushAssessment?
  queueItem    DoctorQueueItem?
  timeline     TimelineEntry[]
  auditEvents  AuditEvent[]

  @@index([patientId, status])
  @@index([approvedById])
}

model SummarySection {
  id          String             @id @default(cuid())
  summaryId   String
  section     SummarySectionType
  content     String
  aiGenerated Boolean            @default(true)
  editedAt    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  summary     ClinicalSummary    @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@unique([summaryId, section])
}

model AyushAssessment {
  id        String          @id @default(cuid())
  summaryId String          @unique
  prakriti  String?
  vikriti   String?
  agni      String?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  summary   ClinicalSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
}

model DoctorQueueItem {
  id                      String          @id @default(cuid())
  doctorId                Int
  patientId               Int
  summaryId               String          @unique
  assignedByStaffId       Int?
  priority                QueuePriority   @default(NORMAL)
  status                  QueueStatus     @default(PENDING)
  diagnosis               String?
  diagnosisAttachmentName String?
  diagnosisAttachmentKey  String?
  assignedAt              DateTime        @default(now())
  diagnosedAt             DateTime?
  doctor                  User            @relation("QueueDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  patient                 Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  summary                 ClinicalSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  assignedByStaff         User?           @relation("QueueAssignedBy", fields: [assignedByStaffId], references: [id], onDelete: SetNull)

  @@index([doctorId, priority, status])
  @@index([patientId])
  @@index([assignedByStaffId])
}

model StaffDoctorFavorite {
  staffId   Int
  doctorId  Int
  createdAt DateTime @default(now())
  staff     User     @relation("FavoriteStaff", fields: [staffId], references: [id], onDelete: Cascade)
  doctor    User     @relation("FavoriteDoctor", fields: [doctorId], references: [id], onDelete: Cascade)

  @@id([staffId, doctorId])
  @@index([doctorId])
}

model TimelineEntry {
  id          String           @id @default(cuid())
  patientId   Int
  interviewId String?
  documentId  String?
  summaryId   String?
  label       String
  source      TimelineSource
  occurredAt  DateTime         @default(now())
  patient     Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  interview   Interview?       @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  document    MedicalDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  summary     ClinicalSummary? @relation(fields: [summaryId], references: [id], onDelete: SetNull)

  @@index([patientId, occurredAt])
  @@index([interviewId])
  @@index([documentId])
  @@index([summaryId])
}

model VerificationChallenge {
  id          String              @id @default(cuid())
  patientId   Int?
  userId      Int?
  channel     VerificationChannel
  purpose     VerificationPurpose
  destination String
  codeHash    String
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime            @default(now())
  patient     Patient?            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([patientId, purpose])
  @@index([userId, purpose])
}

model AuditEvent {
  id          String           @id @default(cuid())
  actorId     Int?
  patientId   Int?
  interviewId String?
  summaryId   String?
  action      String
  details     Json?
  createdAt   DateTime         @default(now())
  actor       User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  patient     Patient?         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  interview   Interview?       @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  summary     ClinicalSummary? @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@index([interviewId])
  @@index([summaryId])
  @@index([actorId])
}
